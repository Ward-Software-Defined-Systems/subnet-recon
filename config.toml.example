# subnet-recon configuration
# Copy this file to config.toml and edit to match your environment:
#   cp config.toml.example config.toml

[scan]
# Probe method: "icmp" (requires root) or "tcp" (no root, slower)
method = "icmp"

# Timeout per probe in milliseconds
timeout_ms = 1000

# Number of worker threads (0 = use all available cores)
threads = 0

# Maximum probes per second across all threads (0 = unlimited)
rate_limit = 0

# Randomize IP order before scanning
# "global" = shuffle all IPs from all subnets together
# "per_subnet" = shuffle within each subnet, then interleave
# "none" = sequential order
randomize = "per_subnet"

# TCP port to probe when method = "tcp"
tcp_port = 80

[output]
# Write reachable hosts to file (empty string = stdout only)
file = ""

# Output format: "plain" (one IP per line) or "json"
format = "plain"

# Include unreachable hosts in output
include_unreachable = false

[dns]
# Custom DNS servers for reverse lookups (empty = system default)
# servers = ["8.8.8.8", "1.1.1.1"]
servers = []

# DNS query timeout in milliseconds
timeout_ms = 3000

[[subnets]]
cidr = "192.168.1.0/24"
label = "Example LAN"

#[[subnets]]
#cidr = "10.0.0.0/24"
#label = "Another subnet"
